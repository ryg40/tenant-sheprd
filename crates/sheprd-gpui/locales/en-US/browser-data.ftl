# The question before the cookies and site storage of browser
# tabs are removed, which `sheprd browser clear-data` opens.

browser-data-title = Clear the data of browser tabs?
browser-data-note = The cookies and site storage of every site are removed. You are signed out of every site in browser tabs.
# Shown below it when browser tabs were opened in this run.
browser-data-note-open-pages = Cookies are removed at once. Pages opened in this run keep the other data they hold until Sheprd quits; restart Sheprd to complete the removal.
browser-data-cancel = Cancel
browser-data-confirm = Clear
# Shown once the data is gone.
browser-data-cleared = Cleared the data of browser tabs
# Shown when pages were opened in this run: the cookies are gone, and the
# rest goes when the app quits.
browser-data-cleared-running = Cleared the cookies of browser tabs. Restart Sheprd to complete the removal of site storage.

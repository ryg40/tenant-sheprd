# Why Servo, which draws pages on Linux, could not draw one.

error-servo-page-address = The page's address is not one Servo can load.
error-servo-page-busy = The engine that draws pages is busy; the request was dropped.
# $error is the system's own reason, in its own words.
error-servo-page-data = Could not reach the folder that keeps the data of browser tabs: { $error }
error-servo-page-data-folder = The folder that keeps the data of browser tabs is not a folder of this user.
error-servo-page-data-in-use = Another Sheprd has the folder that keeps the data of browser tabs open.
error-servo-page-data-unanswered = The engine that draws pages did not answer. The data of browser tabs is removed when Sheprd next starts.
# What a tab shows in place of its page when the page stopped working:
# Servo's thread that ran the page's script ended.
error-servo-page-script-ended = This page stopped working.
error-servo-page-stopped = The engine that draws pages stopped. Restart Sheprd to open pages again.
error-servo-page-surface = Servo could not create a drawing surface for the page: { $error }
error-servo-page-thread = Could not start the thread that draws pages: { $error }
